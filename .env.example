# Переименуй этот файл в .env и подставь свои значения
YANDEX_RASP_API_KEY=ВАШ_КЛЮЧ_ОТ_ЯНДЕКС_РАСПИСАНИЙ
PORT=3000

# Пароль только для администратора ручных поездов.
# Используй длинный уникальный пароль и не коммить реальное значение.
ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

# Необязательно. На хостинге с persistent disk укажи путь на этом диске,
# чтобы ручные поезда не терялись после redeploy.
# MANUAL_TRAINS_FILE=/var/data/udelnaya/manual-trains.json
